<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heima.news.mapper.NewsMapper">

    <resultMap id="BaseResultMap" type="com.heima.news.entity.NewsMsg">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="category" jdbcType="INTEGER" property="category"/>
        <result column="title" jdbcType="VARCHAR" property="title"/>
        <result column="pic" jdbcType="VARCHAR" property="pic"/>
        <result column="content" jdbcType="LONGVARCHAR" property="content"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="dict_name" jdbcType="VARCHAR" property="dictName"/>
        <result column="dict_type" jdbcType="VARCHAR" property="dictType"/>
        <result column="dict_label" jdbcType="VARCHAR" property="dictLabel"/>
        <result column="dict_value" jdbcType="VARCHAR" property="dictValue"/>
        <result column="is_default" jdbcType="VARCHAR" property="isDefault"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>

    <sql id="BaseColumns">
        id, category, title, pic, content, create_time, update_time,
        dict_name, dict_type, dict_label, dict_value, is_default, remark
    </sql>

    <select id="selectTopByCategory" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM v_ai_msg
        WHERE category = #{category}
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <select id="selectPageByCategory" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM v_ai_msg
        WHERE category = #{category}
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByCategory" resultType="long">
        SELECT COUNT(*) FROM v_ai_msg WHERE category = #{category}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM v_ai_msg
        WHERE id = #{id}
    </select>

</mapper>
